# Токен бота от @BotFather
TG_TOKEN=

# Ваш chat_id. Узнать: напишите боту /start, затем запустите get_chat_id.py
TG_CHAT_ID=

# Сколько секунд ждать нажатия кнопки
CC_TG_TIMEOUT=300

# Тихие часы: в это время ничего не отправляется, вопросы идут в терминал.
# Пример: 23:00-08:00. Пусто — выключено.
CC_TG_QUIET=

# 1 — разрешить отвечать Claude с телефона (хук Stop ждёт ваш текст)
CC_TG_FOLLOWUP=0
# Сколько секунд ждать ваш текст
CC_TG_FOLLOWUP_WAIT=90
# Сколько продолжений подряд разрешено
CC_TG_FOLLOWUP_MAX=3

# Сколько символов ответа присылать (0 — без предела)
CC_TG_ANSWER_LIMIT=10000

# Стикеры: all, decisions или off. Пусто — авто (включены, если заполнен
# stickers.json)
CC_TG_STICKERS=

# 1 — печатать подробности в поток ошибок (для отладки)
CC_TG_DEBUG=0
